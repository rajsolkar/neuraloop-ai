// Prisma schema for Neuraloop Phase 9 (Clerk Auth & Multi-Tenant Security)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id                     String               @id
  userId                 String?              // Clerk User ID (nullable for legacy records)
  name                   String
  description            String               @default("")
  status                 String               @default("draft") // draft, published, archived
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  savedAt                DateTime?
  publishedAt            DateTime?
  currentVersionId       String?
  publishedVersionId     String?
  publishedVersionNumber Int?
  activeVersionId        String?
  activeVersionNumber    Int?
  webhookSecret          String?
  versions               WorkflowVersion[]
  executions             WorkflowExecution[]
  generations            WorkflowGeneration[]
  schedules              WorkflowSchedule[]

  @@index([userId])
  @@map("workflows")
}

model WorkflowVersion {
  id          String              @id
  workflowId  String
  version     Int
  definition  Json
  publishedAt DateTime?
  isActive    Boolean             @default(false)
  comment     String?
  createdAt   DateTime            @default(now())
  workflow    Workflow            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id                String          @id @default(uuid())
  userId            String?         // Clerk User ID of workflow owner
  workflowId        String
  workflowVersionId String
  status            String          @default("queued") // queued, running, success, failed, cancelled
  source            String          @default("manual") // manual, webhook, schedule, api
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  duration          Int?            // in milliseconds
  input             Json?
  output            Json?
  error             String?
  metadata          Json?
  triggerMetadata   Json?
  workflow          Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version           WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  nodeExecutions    NodeExecution[]

  @@index([userId])
  @@index([workflowId])
  @@index([workflowVersionId])
  @@index([status])
  @@index([source])
  @@index([startedAt])
  @@map("workflow_executions")
}

model NodeExecution {
  id          String            @id @default(uuid())
  executionId String
  nodeId      String
  nodeType    String
  status      String            @default("pending") // pending, running, success, failed, skipped, cancelled
  startedAt   DateTime          @default(now())
  completedAt DateTime?
  duration    Int?              // in milliseconds
  input       Json?
  output      Json?
  error       String?
  attempt     Int               @default(1)
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([nodeId])
  @@index([status])
  @@map("node_executions")
}

model WorkflowGeneration {
  id         String    @id @default(uuid())
  userId     String?   // Clerk User ID
  prompt     String    @db.Text
  workflowId String?
  status     String    // success, failed, rejected
  error      String?   @db.Text
  tokensUsed Int?
  createdAt  DateTime  @default(now())
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workflowId])
  @@index([createdAt])
  @@map("workflow_generations")
}

model Credential {
  id             String    @id @default(uuid())
  userId         String    // Clerk User ID
  name           String
  provider       String    // openai, anthropic, gemini, slack, smtp, custom
  encryptedValue String    @db.Text
  iv             String
  metadata       Json?     // Provider configuration (smtpHost, port, username, etc.)
  lastUsedAt     DateTime? // Usage tracking timestamp
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([provider])
  @@map("credentials")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  userId      String?  // null = official Neuraloop template, string = custom private template
  name        String
  description String
  category    String   @default("general")
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("workflow_templates")
}

model WorkflowSchedule {
  id             String    @id @default(uuid())
  workflowId     String
  userId         String    // Clerk User ID of workflow owner
  enabled        Boolean   @default(true)
  cronExpression String
  timezone       String    @default("UTC")
  nextRunAt      DateTime
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([nextRunAt])
  @@index([enabled, nextRunAt])
  @@map("workflow_schedules")
}

